{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,


    // ✅ Fix alias (root-level components)
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  }
}
